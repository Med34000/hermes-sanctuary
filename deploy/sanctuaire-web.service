# Sanctuaire — serveur web interne + relais du chat vers l'API de Hermes
# (127.0.0.1 uniquement, accès par tunnel SSH ; la clé API est lue via LoadCredential, jamais exposée à la page)
# 2026-11-02 ≈19:50 (Europe/Zurich) — Claude (Cowork) — Anthropic, Claude Opus 5.5
[Unit]
Description=Sanctuaire - page web interne et relais chat (127.0.0.1:8787)
After=network.target hermes-gateway.service

[Service]
Type=simple
DynamicUser=yes
Environment=SANCTUAIRE_WEB=/opt/sanctuaire/web SANCTUAIRE_PORT=8787 HERMES_API=http://127.0.0.1:9119
LoadCredential=api.key:/etc/sanctuaire/api.key
ExecStart=/usr/bin/python3 /opt/sanctuaire/deploy/sanctuaire_server.py
Restart=on-failure
RestartSec=5
# Durcissement : lecture seule, aucun privilège
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadOnlyPaths=/opt/sanctuaire /var/lib/sanctuaire
MemoryMax=96M

[Install]
WantedBy=multi-user.target
